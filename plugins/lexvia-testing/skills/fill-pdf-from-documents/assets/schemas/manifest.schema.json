{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/fill-pdf-from-documents/manifest.schema.json",
  "title": "Source intake manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "capability_inventory": {
      "type": "object",
      "properties": {
        "discovery": {
          "enum": [
            "complete",
            "partial",
            "not_provided"
          ]
        },
        "readers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "available": {
                "type": "boolean"
              },
              "headless": {
                "const": true
              }
            },
            "required": [
              "id",
              "version",
              "formats",
              "available",
              "headless"
            ]
          }
        }
      },
      "required": [
        "discovery",
        "readers"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "content_id": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duplicate_of": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "native",
                  "pdf",
                  "fallback_needed",
                  "capability_unknown",
                  "unsupported",
                  "fallback_pdf"
                ]
              },
              "reader_id": {
                "type": "string",
                "minLength": 1
              },
              "reader_version": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status"
            ]
          },
          "extraction": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "pending",
                  "duplicate",
                  "excluded",
                  "error",
                  "unreadable",
                  "unsupported"
                ]
              },
              "coverage": {
                "type": [
                  "object",
                  "array",
                  "string"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status"
            ]
          },
          "lineage": {
            "type": "object",
            "properties": {
              "parent_source_id": {
                "type": "string",
                "minLength": 1
              },
              "attachment_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": []
          },
          "derivatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "derivative_id": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "const": "pdf"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "converter": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ]
                },
                "conversion_status": {
                  "enum": [
                    "complete",
                    "partial",
                    "failed"
                  ]
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "page_mapping": {
                  "type": "array"
                }
              },
              "required": [
                "derivative_id",
                "format",
                "path",
                "sha256",
                "reason",
                "converter",
                "conversion_status",
                "limitations"
              ]
            }
          }
        },
        "required": [
          "source_id",
          "relative_path",
          "original_path",
          "format",
          "size_bytes",
          "sha256",
          "route",
          "extraction"
        ]
      }
    },
    "excluded": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_root",
    "sources"
  ]
}
